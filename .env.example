# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# Servidor web
APP_HOST=127.0.0.1
APP_PORT=8000
# Orígenes permitidos para CORS separados por comas (vacío = solo mismo origen)
CORS_ORIGINS=

# Base de datos y caché
DB_PATH=data/mh_builder.sqlite3
CACHE_DIR=data/cache
IMAGES_DIR=data/images

# Scraping
SCRAPER_USER_AGENT=mh-builder-web/1.0 (fan project; educational)
SCRAPER_DELAY_SECONDS=0.5
SCRAPER_CACHE_HOURS=168

# Fuentes de datos
WORLD_DATA_REPO_URL=https://raw.githubusercontent.com/gatheringhallstudios/MHWorldData/master/source_data
WORLD_API_URL=https://mhw-db.com
WILDS_API_URL=https://wilds.mhdb.io
RISE_SITE_URL=https://mhrise.kiranico.com
WORLD_KIRANICO_URL=https://mhworld.kiranico.com
WILDS_KIRANICO_URL=https://mhwilds.kiranico.com
